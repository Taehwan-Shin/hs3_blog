---
import { getEntry, render } from 'astro:content';

const post = await getEntry('posts', 'my-blog/2026-05-14-firebase-analytics-case-study');
if (!post) throw new Error('Post not found');

const { Content, headings } = await render(post);
---

<html>
<body>
  <h1>TEST PAGE</h1>
  <h2>Headings count: {headings.length}</h2>
  <h2>Body length: {post.body?.length}</h2>
  <div id="content-goes-here">
    <Content />
  </div>
</body>
</html>
