---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import { shouldShowPost } from '@/utils/markdown';
import PostLayout from '@/layouts/PostLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts');
  const isDev = import.meta.env.DEV;
  const visiblePosts = posts.filter(post => shouldShowPost(post, isDev));

  // Pass only the id — the full entry object cannot be serialized through getStaticPaths
  // without losing the body() getter that render() needs.
  return visiblePosts.map(post => ({
    params: { slug: post.id },
    props: { id: post.id }
  }));
};

export interface Props {
  id: string;
}

const { id } = Astro.props;
// Re-fetch with getEntry so the full entry (including body getter) is available.
const post = await getEntry('posts', id);

if (!post) {
  return Astro.redirect('/404');
}

const isDev = import.meta.env.DEV;
if (!shouldShowPost(post, isDev)) {
  return Astro.redirect('/404');
}
---

<PostLayout post={post} />
