---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { shouldShowPost } from '@/utils/markdown';
import { processMarkdown, calculateReadingTime, generateTOC } from '@/utils/markdown';
import PostLayout from '@/layouts/PostLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts');
  const isDev = import.meta.env.DEV;
  const visiblePosts = posts.filter(post => shouldShowPost(post, isDev));

  return visiblePosts.map(post => ({
    params: { slug: post.id },
    props: { id: post.id }
  }));
};

export interface Props {
  id: string;
}

const { id } = Astro.props;
const post = await getEntry('posts', id);

if (!post) {
  return Astro.redirect('/404');
}

const isDev = import.meta.env.DEV;
if (!shouldShowPost(post, isDev)) {
  return Astro.redirect('/404');
}

// Render post content at build-time (before props serialization)
const { Content, headings, remarkPluginFrontmatter } = await render(post);

// Extract metadata from markdown (for props passed to PostLayout)
const { wordCount, hasMore } = processMarkdown(post.body || '');
const readingTime = calculateReadingTime(post.body || '');
const toc = await generateTOC(headings);
---

<PostLayout post={post} Content={Content} headings={headings} remarkPluginFrontmatter={remarkPluginFrontmatter} wordCount={wordCount} readingTime={readingTime} toc={toc} />
