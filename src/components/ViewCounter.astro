---
import Icon from './Icon.astro';

interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<div class="flex items-center gap-1.5 text-primary-600 dark:text-primary-300" id="view-counter-container" data-post-id={postId}>
  <span class="text-primary-300 dark:text-primary-600">•</span>
  <Icon name="eye" class="w-3.5 h-3.5" />
  <span id="view-count-text">조회수 ...회</span>
</div>

<script>
  async function initializeViewCounter() {
    const container = document.getElementById('view-counter-container');
    if (!container) return;

    const postId = container.dataset.postId;
    const viewCountText = document.getElementById('view-count-text');
    if (!postId || !viewCountText) return;

    // Import Firebase lazily so it doesn't block page rendering
    let db: any, firebaseReady: boolean, ref: any, runTransaction: any, get: any;
    try {
      const firebaseModule = await import('../lib/firebase');
      const dbModule = await import('firebase/database');
      db = firebaseModule.db;
      firebaseReady = firebaseModule.firebaseReady;
      ref = dbModule.ref;
      runTransaction = dbModule.runTransaction;
      get = dbModule.get;
    } catch (e) {
      console.warn('[ViewCounter] Firebase load failed:', e);
      return;
    }

    if (!firebaseReady || !db) return;

    const kstDate = new Date(new Date().getTime() + 9 * 60 * 60 * 1000).toISOString().split('T')[0];
    const storageKey = `hs3_viewed_${postId}_${kstDate}`;
    const hasViewedToday = localStorage.getItem(storageKey) === 'true';

    try {
      const viewRef = ref(db, `views/posts/${postId}`);

      if (!hasViewedToday) {
        const result = await runTransaction(viewRef, (current: number) => (current || 0) + 1);
        if (result.committed) {
          viewCountText.textContent = `조회수 ${(result.snapshot?.val() || 0).toLocaleString()}회`;
          localStorage.setItem(storageKey, 'true');
        }
      } else {
        const snapshot = await get(viewRef);
        viewCountText.textContent = `조회수 ${(snapshot?.val() || 0).toLocaleString()}회`;
      }
    } catch (e: any) {
      console.warn('[ViewCounter] Firebase operation failed:', e?.code, e?.message);
    }
  }

  window.initializeViewCounter = initializeViewCounter;

  // Run after page is interactive, non-blocking
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(initializeViewCounter, 0));
  } else {
    setTimeout(initializeViewCounter, 0);
  }

  // Re-run on Swup page navigation
  if (window.swup) {
    window.swup.hooks.on('page:view', initializeViewCounter);
  } else {
    document.addEventListener('swup:enable', () => {
      window.swup?.hooks.on('page:view', initializeViewCounter);
    });
  }
</script>
